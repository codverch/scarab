/* Shadow RFP parameters — match hpca2027-rfp / ISCA'22 Table 1 defaults
 * (rfp_6kb: PT 128x8, PAT 16x4). Sized via the same knobs as rfp.param.def. */
DEF_PARAM(shadow_rfp_pt_num_sets, SHADOW_RFP_PT_NUM_SETS, uns, uns, 128, )
DEF_PARAM(shadow_rfp_pt_num_ways, SHADOW_RFP_PT_NUM_WAYS, uns, uns, 8, )
DEF_PARAM(shadow_rfp_pat_num_sets, SHADOW_RFP_PAT_NUM_SETS, uns, uns, 16, )
DEF_PARAM(shadow_rfp_pat_num_ways, SHADOW_RFP_PAT_NUM_WAYS, uns, uns, 4, )
