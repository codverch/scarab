/* FCT lookup and insertion (keyed by LD1 PC). */
DEF_STAT(FCT_LOOKUP_HITS, COUNT, NO_RATIO)
DEF_STAT(FCT_LOOKUP_MISSES, COUNT, NO_RATIO)
DEF_STAT(FCT_LOOKUP_LOW_CONF, COUNT, NO_RATIO)
DEF_STAT(FCT_PRELOAD_INSERTS, COUNT, NO_RATIO)
DEF_STAT(FCT_PRELOAD_DUPLICATE_LD1_SKIPS, COUNT, NO_RATIO)
DEF_STAT(FCT_RUNTIME_INSERTS, COUNT, NO_RATIO)
DEF_STAT(FCT_RUNTIME_REPLACEMENTS, COUNT, NO_RATIO)
DEF_STAT(FCT_RUNTIME_REINFORCEMENTS, COUNT, NO_RATIO)
DEF_STAT(FCT_RUNTIME_CONFLICTS, COUNT, NO_RATIO)
/* A new LD1 needed a row in a full set and evicted the tree-PLRU victim. */
DEF_STAT(FCT_EVICTIONS, COUNT, NO_RATIO)

/* Why entries leave the RLB (retired load buffer), other than by matching.
 *
 * AGE: the entry got older than IFUSE_FUSION_DISTANCE. It is counted the next
 * time its set is accessed, so entries in sets that are never touched again
 * are missed.
 *
 * CAPACITY: the entry was still young enough to fuse, but its set was full
 * and it was the oldest. This is lost opportunity. If CAPACITY is large
 * relative to AGE, the RLB is too small (raise ifuse_rlb_capacity) or loads
 * are crowding into a few sets (raise ifuse_rlb_ways). */
DEF_STAT(RLB_AGE_EVICTIONS, COUNT, NO_RATIO)
DEF_STAT(RLB_CAPACITY_EVICTIONS, COUNT, NO_RATIO)
/* Matches where the partial tag agreed but the full line address did not:
 * a load paired with an unrelated older load. Simulator-only check. */
DEF_STAT(RLB_TAG_ALIAS_MATCHES, COUNT, NO_RATIO)

/* Retire-stage runtime candidate discovery and bounded training table. */
DEF_STAT(IFUSE_TRAINING_PAIRS_DISCOVERED, COUNT, NO_RATIO)
DEF_STAT(IFUSE_TRAINING_STORE_INVALIDATIONS, COUNT, NO_RATIO)
DEF_STAT(IFUSE_TRAINING_CROSS_LINE_LOADS, COUNT, NO_RATIO)
DEF_STAT(TRAINING_TABLE_LOOKUPS, COUNT, NO_RATIO)
DEF_STAT(TRAINING_TABLE_HITS, COUNT, NO_RATIO)
DEF_STAT(TRAINING_TABLE_MISSES, COUNT, NO_RATIO)
DEF_STAT(TRAINING_TABLE_INSERTS, COUNT, NO_RATIO)
DEF_STAT(TRAINING_TABLE_EVICTIONS, COUNT, NO_RATIO)
DEF_STAT(TRAINING_TABLE_OBSERVATIONS, COUNT, NO_RATIO)
DEF_STAT(TRAINING_TABLE_PROMOTIONS, COUNT, NO_RATIO)
DEF_STAT(TRAINING_TABLE_PROMOTION_REJECTS, COUNT, NO_RATIO)
DEF_STAT(TRAINING_TABLE_PEAK_LIVE, COUNT, NO_RATIO)

/* APT lookup (keyed by LD2 PC; live LD1->LD2 predictions). */
DEF_STAT(APT_LOOKUP_HITS, COUNT, NO_RATIO)
DEF_STAT(APT_LOOKUP_MISSES, COUNT, NO_RATIO)
/* Configured capacity (sets x ways); set once at apt_init. */
DEF_STAT(APT_CONFIGURED_CAPACITY, COUNT, NO_RATIO)
DEF_STAT(APT_INSERTS, COUNT, NO_RATIO)
DEF_STAT(APT_EVICTIONS, COUNT, NO_RATIO)
/* Unmatched entries replaced by a newer LD1 for the same LD2 PC
 * (ifuse_apt_unique_ld2). */
DEF_STAT(APT_SAME_LD2_OVERWRITES, COUNT, NO_RATIO)
/* Legacy: set-assoc APT always finds a way via PLRU eviction. */
DEF_STAT(APT_INSERT_FAILURES, COUNT, NO_RATIO)
DEF_STAT(APT_LIVE_LD2_PREDICTION_PEAK, COUNT, NO_RATIO)
DEF_STAT(APT_LIVE_LD2_PREDICTION_OBSERVATIONS, COUNT, NO_RATIO)
DEF_STAT(APT_LIVE_LD2_PREDICTION_TOTAL, COUNT, NO_RATIO)
/* Average live APT entries = TOTAL / OBSERVATIONS. */
DEF_STAT(APT_LIVE_LD2_PREDICTION_AVG, RATIO, APT_LIVE_LD2_PREDICTION_OBSERVATIONS)
/* In-flight fusion candidates (valid APT entries), sampled once per cycle.
 * Average per cycle = TOTAL / OBSERVED_CYCLES. */
DEF_STAT(IFUSE_INFLIGHT_CANDIDATES_OBSERVED_CYCLES, COUNT, NO_RATIO)
DEF_STAT(IFUSE_INFLIGHT_CANDIDATES_TOTAL, COUNT, NO_RATIO)
DEF_STAT(IFUSE_INFLIGHT_CANDIDATES_PER_CYCLE, RATIO, IFUSE_INFLIGHT_CANDIDATES_OBSERVED_CYCLES)

/* In-flight fused pairs between map and early-wakeup completion. */
DEF_STAT(IFUSE_INFLIGHT_FUSED_PAIRS_PEAK, COUNT, NO_RATIO)
DEF_STAT(IFUSE_INFLIGHT_FUSED_PAIRS_OBSERVATIONS, COUNT, NO_RATIO)
DEF_STAT(IFUSE_INFLIGHT_FUSED_PAIRS_TOTAL, COUNT, NO_RATIO)

/* ACI lookup (predicted vs actual LD2 cache block). */
DEF_STAT(ACI_LOOKUP_HITS, COUNT, NO_RATIO)
DEF_STAT(ACI_LOOKUP_MISSES, COUNT, NO_RATIO)
DEF_STAT(ACI_REPLAYED_INSERTS, COUNT, NO_RATIO)
DEF_STAT(ACI_EVICTIONS, COUNT, NO_RATIO)
/* Legacy: set-assoc ACI always finds a way via PLRU eviction. */
DEF_STAT(ACI_BACKING_ALLOC_FAILURES, COUNT, NO_RATIO)
DEF_STAT(ACI_PREDICTION_INSERTS, COUNT, NO_RATIO)
DEF_STAT(ACI_SAME_CACHEBLOCK_INSERTS, COUNT, NO_RATIO)
DEF_STAT(ACI_PREDICTION_INVALIDATIONS, COUNT, NO_RATIO)
DEF_STAT(ACI_STALE_PREDICTION_REMOVALS, COUNT, NO_RATIO)

/* GP physical-register pressure (all rename traffic, including I-Fuse extras). */
DEF_STAT(IFUSE_GP_REG_OCCUPIED_PEAK, COUNT, NO_RATIO)
DEF_STAT(IFUSE_GP_REG_OCCUPIED_OBSERVATIONS, COUNT, NO_RATIO)
DEF_STAT(IFUSE_GP_REG_OCCUPIED_TOTAL, COUNT, NO_RATIO)
DEF_STAT(IFUSE_GP_REG_UTIL_PCT_TOTAL, COUNT, NO_RATIO)

/* Extra physical registers held for predicted/fused LOAD2 results. */
DEF_STAT(IFUSE_EXTRA_REG_IN_USE_PEAK, COUNT, NO_RATIO)
DEF_STAT(IFUSE_EXTRA_REG_IN_USE_OBSERVATIONS, COUNT, NO_RATIO)
DEF_STAT(IFUSE_EXTRA_REG_IN_USE_TOTAL, COUNT, NO_RATIO)

/* I-Fuse fusion prediction outcomes (fetch-time validation). */
DEF_STAT(IFUSE_LOAD1_PREDICTIONS, COUNT, NO_RATIO)
DEF_STAT(IFUSE_CORRECT_PREDICTIONS, COUNT, NO_RATIO)
DEF_STAT(IFUSE_INCORRECT_PREDICTIONS, COUNT, NO_RATIO)

/* I-Fuse fusion outcomes (retire / recovery). */
DEF_STAT(IFUSE_FUSED_LOADS, COUNT, NO_RATIO)
DEF_STAT(IFUSE_MISPREDICTED_LOADS, COUNT, NO_RATIO)
DEF_STAT(IFUSE_MISPREDICTION_FLUSHES, COUNT, NO_RATIO)
DEF_STAT(IFUSE_MISPREDICTED_CACHE_BLOCK_ADDR, COUNT, NO_RATIO)
DEF_STAT(IFUSE_MISPREDICTED_OFFSET_DELTA, COUNT, NO_RATIO)

/* --- Observed load stalls (compare across baseline / RFP / I-Fuse runs) ---
 * Stall = done_cycle - exec_cycle: cycles the load waited for its data.
 * We do NOT invent an L1-hit "cycles saved" number (fusion skips the demand
 * access, so we never learn hit vs miss). Instead compare totals across runs:
 *   stalls_removed ≈ IFUSE_LD_STALL_CYCLES(baseline) - IFUSE_LD_STALL_CYCLES(ifuse)
 * Coverage × avg stall on fused loads explains how much of that is coverage
 * vs timeliness when set next to RFP's same-style stall totals.
 */

/* Every on-path load that retires. */
DEF_STAT(IFUSE_ALL_LOADS, COUNT, NO_RATIO)
/* Retired loads that used the fused path (LD2 early-woken). */
DEF_STAT(IFUSE_NUM_FUSED_LOADS, COUNT, NO_RATIO)
/* Retired loads that used the normal demand memory path. */
DEF_STAT(IFUSE_NUM_DEMAND_LOADS, COUNT, NO_RATIO)
/* Fraction of retired loads that used fusion. */
DEF_STAT(IFUSE_LOAD_COVERAGE, RATIO, IFUSE_ALL_LOADS)

/* Sum of stall cycles (done - exec) over all / fused / demand loads. */
DEF_STAT(IFUSE_LD_STALL_CYCLES, COUNT, NO_RATIO)
DEF_STAT(IFUSE_LD_STALL_CYCLES_FUSED, COUNT, NO_RATIO)
DEF_STAT(IFUSE_LD_STALL_CYCLES_DEMAND, COUNT, NO_RATIO)
/* Average stall per load in each group. */
DEF_STAT(IFUSE_AVG_STALL_PER_LOAD, RATIO, IFUSE_ALL_LOADS)
DEF_STAT(IFUSE_AVG_STALL_PER_FUSED, RATIO, IFUSE_NUM_FUSED_LOADS)
DEF_STAT(IFUSE_AVG_STALL_PER_DEMAND, RATIO, IFUSE_NUM_DEMAND_LOADS)

/* Fused LD2: LD1 data already ready when LD2 finished AGU. */
DEF_STAT(IFUSE_FULL_MITIGATED, COUNT, NO_RATIO)
/* Fused LD2: LD1 data arrived after LD2 AGU (observed leftover wait). */
DEF_STAT(IFUSE_PARTIAL_MITIGATED, COUNT, NO_RATIO)
/* Sum of (LD1_wake - AGU) when LD1 was late; 0 for full mitigation. */
DEF_STAT(IFUSE_REMAINING_WAIT_AFTER_AGU, COUNT, NO_RATIO)

/* Prefetch timeliness: how early LD1 data was ready before LD2 reached AGU.
 * prefetch_lead = max(0, LD2_AGU_cycle - LD1_wake_cycle) per fused LD2.
 * Measures LD1 finishing ahead of when LD2 needs its fused result. */
DEF_STAT(IFUSE_PREFETCH_LEAD_OPPORTUNITIES, COUNT, NO_RATIO)
DEF_STAT(IFUSE_PREFETCH_LEAD_EVENTS, COUNT, NO_RATIO)
DEF_STAT(IFUSE_PREFETCH_LEAD_CYCLES, COUNT, NO_RATIO)
DEF_STAT(IFUSE_AVG_PREFETCH_LEAD, RATIO, IFUSE_PREFETCH_LEAD_OPPORTUNITIES)
/* Dynamic on-path load distance (LD2_load_num - LD1_load_num) at fusion. */
DEF_STAT(IFUSE_PAIR_DISTANCE_TOTAL, COUNT, NO_RATIO)
DEF_STAT(IFUSE_AVG_PAIR_DISTANCE, RATIO, IFUSE_PREFETCH_LEAD_OPPORTUNITIES)

/* --- Other load latency at retire (on-path only) --- */
/* Sum over loads of (exec_cycle - fetch_cycle). */
DEF_STAT(IFUSE_LD_EXEC_MINUS_FETCH, COUNT, NO_RATIO)
/* Sum over loads of (retire_cycle - fetch_cycle). */
DEF_STAT(IFUSE_LD_RETIRE_MINUS_FETCH, COUNT, NO_RATIO)
/* Alias of IFUSE_LD_STALL_CYCLES (done - exec). */
DEF_STAT(IFUSE_LD_EXEC_TO_DONE, COUNT, NO_RATIO)
DEF_STAT(IFUSE_LD_EXEC_MINUS_FETCH_FUSED, COUNT, NO_RATIO)
DEF_STAT(IFUSE_LD_RETIRE_MINUS_FETCH_FUSED, COUNT, NO_RATIO)
DEF_STAT(IFUSE_LD_EXEC_TO_DONE_FUSED, COUNT, NO_RATIO)
DEF_STAT(IFUSE_LD_EXEC_MINUS_FETCH_DEMAND, COUNT, NO_RATIO)
DEF_STAT(IFUSE_LD_RETIRE_MINUS_FETCH_DEMAND, COUNT, NO_RATIO)
DEF_STAT(IFUSE_LD_EXEC_TO_DONE_DEMAND, COUNT, NO_RATIO)

/* Register consumers of a fused LOAD2, by when they renamed relative to
 * LOAD2's data (see ifuse_exec_pair_signal_ld2() and add_to_wake_up_lists()).
 *   WAITING:         renamed before LOAD2's data; woken by it.
 *   RENAMED_IN_DELAY: renamed after LOAD2 fired but before its delayed wake
 *                    cycle, so the wake delay applies to them.
 *   RENAMED_AFTER_READY: renamed once LOAD2's data was visible; unaffected.
 * _CRITICAL: LOAD2 was the consumer's last source, so its wake cycle set the
 * consumer's ready cycle. Consumers renamed after LOAD2 retired are not seen.
 * _LOAD: the consumer is itself a load, so LOAD2's value is (part of) its
 * address, as in a pointer chase LOAD1 -> LOAD2 -> LOAD3. */
DEF_STAT(IFUSE_LD2_CONSUMERS_WAITING, COUNT, NO_RATIO)
DEF_STAT(IFUSE_LD2_CONSUMERS_WAITING_CRITICAL, COUNT, NO_RATIO)
DEF_STAT(IFUSE_LD2_CONSUMERS_RENAMED_IN_DELAY, COUNT, NO_RATIO)
DEF_STAT(IFUSE_LD2_CONSUMERS_RENAMED_IN_DELAY_CRITICAL, COUNT, NO_RATIO)
DEF_STAT(IFUSE_LD2_CONSUMERS_RENAMED_AFTER_READY, COUNT, NO_RATIO)
DEF_STAT(IFUSE_LD2_CONSUMERS_WAITING_LOAD, COUNT, NO_RATIO)
DEF_STAT(IFUSE_LD2_CONSUMERS_WAITING_CRITICAL_LOAD, COUNT, NO_RATIO)
DEF_STAT(IFUSE_LD2_CONSUMERS_RENAMED_IN_DELAY_LOAD, COUNT, NO_RATIO)
DEF_STAT(IFUSE_LD2_CONSUMERS_RENAMED_IN_DELAY_CRITICAL_LOAD, COUNT, NO_RATIO)
DEF_STAT(IFUSE_LD2_CONSUMERS_RENAMED_AFTER_READY_LOAD, COUNT, NO_RATIO)
