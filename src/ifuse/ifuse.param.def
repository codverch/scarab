DEF_PARAM(ifuse_fusion_distance, IFUSE_FUSION_DISTANCE, uns, uns, 512, )
/* RLB physical capacity, decoupled from ifuse_fusion_distance: entries only
 * need to cover the loads live within the distance window, not every
 * micro-op in it. 128 entries = 1.71875 KiB at 110 bits/entry. */
DEF_PARAM(ifuse_rlb_capacity, IFUSE_RLB_CAPACITY, uns, uns, 128, )
DEF_PARAM(ifuse_apt_match_policy, IFUSE_APT_MATCH_POLICY, uns, uns, 1, )

/* Retire-stage runtime discovery. 32 sets x 4 ways = 128 TT entries. */
DEF_PARAM(ifuse_runtime_training_enabled, IFUSE_RUNTIME_TRAINING_ENABLED, Flag, Flag, TRUE, )
DEF_PARAM(ifuse_training_insert_threshold, IFUSE_TRAINING_INSERT_THRESHOLD, uns, uns, 1000, )
DEF_PARAM(ifuse_training_table_sets, IFUSE_TRAINING_TABLE_SETS, uns, uns, 32, )
DEF_PARAM(ifuse_training_table_ways, IFUSE_TRAINING_TABLE_WAYS, uns, uns, 4, )
/* Tag width for TT's ld1_tag only (ld2_tag stays a full 48-bit PC -- it
 * doubles as the value forwarded to FCT_Row.ld2_pc_addr, which must be full
 * precision). With a few hundred live entries at most, 32 bits keeps
 * ld1_tag's alias-collision probability negligible (~3e-5); a collision only
 * costs a shared observation counter, never a wrong promoted PC -- see
 * ifuse_training_table.c for why. */
DEF_PARAM(ifuse_training_table_pc_tag_bits, IFUSE_TRAINING_TABLE_PC_TAG_BITS, uns, uns, 32, )

/* FCT confidence (matches old pgo-ifuse: init 500, predict when > 499, -50 mispred). */
DEF_PARAM(ifuse_fct_conf_threshold, IFUSE_FCT_CONF_THRESHOLD, uns, uns, 499, )
DEF_PARAM(ifuse_fct_mispred_conf_penalty, IFUSE_FCT_MISPRED_CONF_PENALTY, uns, uns, 50, )
DEF_PARAM(ifuse_fct_preload_file, IFUSE_FCT_PRELOAD_FILE, char*, string, NULL, )
DEF_PARAM(ifuse_fct_preload_conf, IFUSE_FCT_PRELOAD_CONF, uns, uns, 500, )
DEF_PARAM(ifuse_fct_runtime_insert_conf, IFUSE_FCT_RUNTIME_INSERT_CONF, uns, uns, 500, )
/* FCT LD1 PC tag width: same collision reasoning as ifuse_training_table_pc_tag_bits,
 * applied only to ld1_pc_addr (the lookup tag). ld2_pc_addr stays full width --
 * see the FCT_Row storage-model comment in ifuse_fct.h for why. */
DEF_PARAM(ifuse_fct_pc_tag_bits, IFUSE_FCT_PC_TAG_BITS, uns, uns, 32, )

/* Tunable table capacities. 2^9 = 512 FCT rows.
 * APT/ACI: set-associative tables with tree-PLRU replacement. */
DEF_PARAM(ifuse_fct_hash_bits, IFUSE_FCT_HASH_BITS, uns, uns, 9, )
/* FCT associativity: 2^ifuse_fct_hash_bits rows in sets of this many ways
 * (4 or 8, tree-PLRU replacement). Default 512 rows = 128 sets x 4 ways. */
DEF_PARAM(ifuse_fct_ways, IFUSE_FCT_WAYS, uns, uns, 4, )
/* Cycles after LD1's wake cycle before a fused LD2's dependents may wake
 * (see ifuse_exec_pair_signal_ld2). 0 = same cycle as LD1. */
DEF_PARAM(ifuse_ld2_wake_delay, IFUSE_LD2_WAKE_DELAY, uns, uns, 1, )
/* Realistic LD2: a fused LD2 still takes a ROB, LQ, and RS entry and computes
 * its address on a load port to validate the prediction, but issues no L1-D
 * access. Off by default, which keeps the true-fusion model. */
DEF_PARAM(ifuse_ld2_realistic, IFUSE_LD2_REALISTIC, Flag, Flag, FALSE, )
/* Ablation, implies ifuse_ld2_realistic: fusion without early data. LD2 issues
 * no L1-D access, but its dependents wake no earlier than LD2's own address
 * generation plus the L1-D hit latency. */
DEF_PARAM(ifuse_ablate_no_early_data, IFUSE_ABLATE_NO_EARLY_DATA, Flag, Flag, FALSE, )
/* Ablation, implies ifuse_ld2_realistic: early data without fusion. LD2's
 * dependents wake on LD1's fused access, but LD2 also issues its own L1-D
 * access and completes through the ordinary load path. */
DEF_PARAM(ifuse_ablate_no_fusion, IFUSE_ABLATE_NO_FUSION, Flag, Flag, FALSE, )
/* 32 sets x 8 ways (was 64x4, same 256-entry total): APT eviction rate was
 * uncorrelated with occupancy (peak never exceeded 61 of 256 across 55
 * benchmark runs; correlation with eviction rate was 0.006) -- thrashing
 * comes from a handful of hot static LD1/LD2 PCs producing many concurrent
 * dynamic instances that all hash to the same set, not from cross-PC set
 * collisions. More ways per set directly targets that; more sets would not,
 * since a given static PC always lands in the same set regardless of set
 * count. */
DEF_PARAM(ifuse_apt_sets, IFUSE_APT_SETS, uns, uns, 32, )
DEF_PARAM(ifuse_apt_ways, IFUSE_APT_WAYS, uns, uns, 8, )
DEF_PARAM(ifuse_aci_sets, IFUSE_ACI_SETS, uns, uns, 64, )
DEF_PARAM(ifuse_aci_ways, IFUSE_ACI_WAYS, uns, uns, 4, )
DEF_PARAM(ifuse_exec_pair_max_nodes, IFUSE_EXEC_PAIR_MAX_NODES, uns, uns, 524288, )
DEF_PARAM(ifuse_exec_pair_num_buckets, IFUSE_EXEC_PAIR_NUM_BUCKETS, uns, uns, 4096, )
